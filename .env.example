DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tindahan_pos?schema=public"
# Direct (non-pooled) URL used by prisma.config.ts for migrations. Locally this can match
# DATABASE_URL; on Neon set it to the non-"-pooler" host (Vercel integration: DATABASE_URL_UNPOOLED).
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/tindahan_pos?schema=public"
AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST="true"
