# Use a hosted PostgreSQL connection string. localhost and 127.0.0.1 will not work on Vercel.
# On Neon, DATABASE_URL must be the POOLED endpoint (host contains "-pooler") so serverless
# request traffic reuses connections instead of opening a new one per invocation.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech:5432/DATABASE?sslmode=require"

# Direct (non-pooled) endpoint, used only for migrations (see prisma.config.ts). On Neon this is
# the same host WITHOUT "-pooler". Neon's Vercel integration provisions this as DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech:5432/DATABASE?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_TRUST_HOST="true"
